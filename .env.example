# Exact deployment origin; no trailing slash. Change before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Disabled until the verified sender and credentials are ready.
CONTACT_ENABLED=false
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Recommended for multi-instance/serverless production rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Both public settings must be set before building when enabling Turnstile.
NEXT_PUBLIC_TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional; disabled when blank. Review privacy disclosure before enabling.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
